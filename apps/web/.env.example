# Production: create a free project at https://neon.tech and paste the pooled
# connection string here. Local development can instead run:
#   npx prisma dev
# which prints a ready-to-use DATABASE_URL (no Docker/Postgres install needed).
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/farmdb?sslmode=require"

# Random secret for signing the owner-dashboard session cookie.
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-value"

# Seed-time owner login credentials.
OWNER_EMAIL="owner@example.com"
OWNER_PASSWORD="choose-a-strong-password"

# Shared PIN that gates the worker-facing data-entry app (separate from the
# owner login above). Give this to your foreman verbally; anyone without it
# is redirected to /gate and cannot read or write farm data.
FARM_PIN="choose-a-6-character-code"
