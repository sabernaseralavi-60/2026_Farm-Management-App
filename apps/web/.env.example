# Production: create a free project at https://neon.tech and paste the pooled
# connection string here. Local development can instead run:
#   npx prisma dev
# which prints a ready-to-use DATABASE_URL (no Docker/Postgres install needed).
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/farmdb?sslmode=require"

# Random secret for signing the owner-dashboard session cookie.
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-value"

# Seed-time owner (مدیر مزرعه) login credentials — daily/range dashboard only.
OWNER_EMAIL="owner@example.com"
OWNER_PASSWORD="choose-a-strong-password"

# Seed-time admin (ادمین مدیریت) login credentials — same dashboard as the
# owner, plus worker performance analytics and the AI database-Q&A page.
# Leave unset to skip creating an admin account.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="choose-a-strong-password"

# Shared PIN that gates the worker-facing data-entry app (separate from the
# owner/admin logins above). Give this to your foreman verbally; anyone
# without it is redirected to /gate and cannot read or write farm data.
FARM_PIN="choose-a-6-character-code"

# Powers the admin "پرسش هوشمند از داده‌ها" (ask-the-database) page. Get a
# free API key at https://openrouter.ai/keys (no payment method required for
# the ":free" models). Leave OPENROUTER_API_KEY unset to keep that page
# showing a "not configured" message instead of erroring.
OPENROUTER_API_KEY=""
# Any OpenRouter model id works; swap in another ":free" model any time —
# see https://openrouter.ai/models?max_price=0 for the current free list
# (availability rotates; verified working at the time of writing).
OPENROUTER_MODEL="nvidia/nemotron-3-super-120b-a12b:free"
